{
  "$defs": {
    "Friend": {
      "additionalProperties": false,
      "properties": {
        "name": {
          "title": "Name",
          "type": "string"
        },
        "handle": {
          "title": "Handle",
          "type": "string"
        },
        "recommendations": {
          "default": false,
          "title": "Recommendations",
          "type": "boolean"
        },
        "rec_days": {
          "default": 7,
          "title": "Rec Days",
          "type": "integer"
        }
      },
      "required": [
        "name",
        "handle"
      ],
      "title": "Friend",
      "type": "object"
    },
    "Publication": {
      "additionalProperties": false,
      "description": "A Substack publication read through its own archive, whether or not the reader subscribes to it.",
      "properties": {
        "name": {
          "title": "Name",
          "type": "string"
        },
        "url": {
          "description": "The publication's home, e.g. https://newsletter.example",
          "title": "Url",
          "type": "string"
        }
      },
      "required": [
        "name",
        "url"
      ],
      "title": "Publication",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": 1,
      "default": 1,
      "title": "Schema Version",
      "type": "integer"
    },
    "me": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "The reader's Substack handle, if they have one; their subscriptions are seeds.",
      "title": "Me"
    },
    "friends": {
      "items": {
        "$ref": "#/$defs/Friend"
      },
      "title": "Friends",
      "type": "array"
    },
    "publications": {
      "description": "Publications fetched directly, like seeds",
      "items": {
        "$ref": "#/$defs/Publication"
      },
      "title": "Publications",
      "type": "array"
    },
    "roundups": {
      "description": "Names of publications whose links count as votes and whose excerpts keep their links",
      "items": {
        "type": "string"
      },
      "title": "Roundups",
      "type": "array"
    },
    "extra_seed_handles": {
      "items": {
        "type": "string"
      },
      "title": "Extra Seed Handles",
      "type": "array"
    },
    "signal_handles": {
      "items": {
        "type": "string"
      },
      "title": "Signal Handles",
      "type": "array"
    },
    "lesswrong": {
      "default": true,
      "description": "Read the week's top LessWrong posts",
      "title": "Lesswrong",
      "type": "boolean"
    }
  },
  "title": "Sources",
  "type": "object"
}
